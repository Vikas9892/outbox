PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL container exposed on 5433)
DATABASE_URL="postgresql://outbox_user:outbox_pass@localhost:5433/outbox_db?schema=public"

# Redis (container exposed on 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Elasticsearch (container exposed on 9200)
ELASTICSEARCH_NODE=http://localhost:9200

# Concurrency & Rate Limiting
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Ethereal Email Credentials (auto-generated if empty)
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
DEV_AUTH_BYPASS=false

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback

# Session Secret
SESSION_SECRET=reachinbox-scheduler-super-secret-key-32chars
