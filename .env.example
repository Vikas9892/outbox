# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL via Docker port 5433)
DATABASE_URL="postgresql://outbox_user:outbox_pass@localhost:5433/outbox_db?schema=public"
POSTGRES_USER=outbox_user
POSTGRES_PASSWORD=outbox_pass
POSTGRES_DB=outbox_db
POSTGRES_PORT=5433

# Redis (via Docker port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Elasticsearch (via Docker port 9200)
ELASTICSEARCH_NODE=http://localhost:9200

# Email Worker Concurrency & Rate Limiting Defaults
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Ethereal Email Credentials (optional: will auto-generate test account if empty)
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
DEV_AUTH_BYPASS=false

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback

# Session Secret
SESSION_SECRET=outbox-dev-secret-key-change-in-production
